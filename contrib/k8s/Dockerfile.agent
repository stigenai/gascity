# Gas City agent container image — binary layer.
#
# Built on top of gc-agent-base (Dockerfile.base) which has all system
# dependencies. This layer only copies project binaries, so rebuilds
# after code changes take ~5s instead of ~2.5 min.
#
# Build:
#   make docker-agent
#   # or: docker build -f contrib/k8s/Dockerfile.agent -t gc-agent:latest .
#
# Full rebuild (base + agent):
#   make docker-base docker-agent
#
# The gc binary should be built first and placed in the build context root:
#   CGO_ENABLED=0 go build -o gc ./cmd/gc

# Local build-layer image produced by Dockerfile.base, not a registry pull.
ARG BASE_IMAGE=gc-agent-base:latest

FROM ghcr.io/astral-sh/uv:0.11.8@sha256:3b7b60a81d3c57ef471703e5c83fd4aaa33abcd403596fb22ab07db85ae91347 AS uv

FROM ubuntu:24.04@sha256:c4a8d5503dfb2a3eb8ab5f807da5bc69a85730fb49b5cfca2330194ebcc41c7b AS omnigent-builder

ARG OMNIGENT_VERSION=0.10.0.dev0
ARG OMNIGENT_SOURCE_REF=2aba5079d4d3a2a84d8c9927884fc4b8ce0eeecc
ARG OMNIGENT_SOURCE_SHA256=62eb5cc546128758211826e4ebb698f813ffd634cf403b34849d132ec18a6ee9
ARG OMNIGENT_SOURCE_DATE_EPOCH=1786796166
ARG OMNIGENT_CRYPTOGRAPHY_CUTOFF=2026-08-15T12:16:06Z
ARG OMNIGENT_CRYPTOGRAPHY_VERSION=50.0.0

ENV DEBIAN_FRONTEND=noninteractive
ENV OMNIGENT_SKIP_WEB_UI=true
ENV UV_PROJECT_ENVIRONMENT=/opt/omnigent

RUN apt-get update && apt-get install -y --no-install-recommends \
	build-essential \
	ca-certificates \
	curl \
	python3 \
	python3-venv \
	&& rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv

RUN mkdir -p /src/omnigent /out \
	&& curl -fsSL --retry 3 \
		"https://github.com/omnigent-ai/omnigent/archive/${OMNIGENT_SOURCE_REF}.tar.gz" \
		-o /tmp/omnigent-source.tar.gz \
	&& echo "${OMNIGENT_SOURCE_SHA256}  /tmp/omnigent-source.tar.gz" | sha256sum --check --strict \
	&& tar -xzf /tmp/omnigent-source.tar.gz --strip-components=1 -C /src/omnigent \
	&& rm -f /tmp/omnigent-source.tar.gz

WORKDIR /src/omnigent
RUN uv sync --locked --no-dev --no-editable \
	&& uv pip install --python /opt/omnigent/bin/python3 \
		--exclude-newer-package "cryptography=${OMNIGENT_CRYPTOGRAPHY_CUTOFF}" \
		"cryptography==${OMNIGENT_CRYPTOGRAPHY_VERSION}" --no-deps \
	&& /opt/omnigent/bin/python3 -c "import cryptography; assert cryptography.__version__ == '${OMNIGENT_CRYPTOGRAPHY_VERSION}'" \
	&& site_dir="$(/opt/omnigent/bin/python3 -c 'import site; print(site.getsitepackages()[0])')" \
	&& printf '%s\n' \
		'"""Gas City image provenance for the pinned Omnigent build."""' \
		'from __future__ import annotations' \
		'' \
		"BUILD_TIME_EPOCH: int = ${OMNIGENT_SOURCE_DATE_EPOCH}" \
		"COMMIT_SHA: str = '${OMNIGENT_SOURCE_REF}'" \
		> "${site_dir}/omnigent/_build_info.py" \
	&& omnigent_short_ref="$(printf '%s' "${OMNIGENT_SOURCE_REF}" | cut -c1-8)" \
	&& /opt/omnigent/bin/omnigent --version \
		| grep -Fq "omnigent ${OMNIGENT_VERSION} (${omnigent_short_ref}," \
	&& omnigent_digest="$(sha256sum /opt/omnigent/bin/omnigent | cut -d ' ' -f1)" \
	&& printf '%s\n' \
		"OMNIGENT_VERSION=${OMNIGENT_VERSION}" \
		"OMNIGENT_SOURCE_REF=${OMNIGENT_SOURCE_REF}" \
		"OMNIGENT_SOURCE_SHA256=sha256:${OMNIGENT_SOURCE_SHA256}" \
		"OMNIGENT_SOURCE_DATE_EPOCH=${OMNIGENT_SOURCE_DATE_EPOCH}" \
		"OMNIGENT_EXECUTABLE_SHA256=sha256:${omnigent_digest}" \
		> /out/omnigent-provenance.env

FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS bd-builder

ARG BD_VERSION=v1.1.0
ARG BD_SOURCE_REF=8e4e59d39f3459a43cf21a3236a13eca4dd874f7
ARG BD_SOURCE_SHA256=63597b6b368d7d26ba3fc570ae3b2fa4cd8a5155d4716cae13d178a560808d5a
ARG BD_BUILD=8e4e59d39
ARG BD_BRANCH=HEAD
ARG GRPC_VERSION=1.82.1

# The published bd 1.1.0 binary embeds vulnerable grpc-go 1.80.0. Rebuild the
# exact released source with its production CGO/pure-Go-regex configuration and
# release identity, changing only the patched dependency version.
RUN mkdir -p /src/bd /out \
    && curl -fsSL --retry 3 \
       "https://github.com/gastownhall/beads/archive/${BD_SOURCE_REF}.tar.gz" \
       -o /tmp/bd-source.tar.gz \
    && echo "${BD_SOURCE_SHA256}  /tmp/bd-source.tar.gz" | sha256sum --check --strict \
    && tar -xzf /tmp/bd-source.tar.gz --strip-components=1 -C /src/bd \
    && rm -f /tmp/bd-source.tar.gz

WORKDIR /src/bd
RUN bd_version="${BD_VERSION#v}" \
	&& grep -Fq "Version = \"${bd_version}\"" cmd/bd/version.go \
	&& go get "google.golang.org/grpc@v${GRPC_VERSION}" \
	&& go get "golang.org/x/crypto@v0.53.0" "golang.org/x/net@v0.56.0" "golang.org/x/text@v0.39.0" \
	&& CGO_ENABLED=1 go build \
       -tags="gms_pure_go" \
       -trimpath \
       -ldflags="-s -w -X main.Version=${bd_version} -X main.Build=${BD_BUILD} -X main.Commit=${BD_SOURCE_REF} -X main.Branch=${BD_BRANCH}" \
       -o /out/bd \
       ./cmd/bd \
    && /out/bd --version | grep -Fq "bd version ${bd_version} (${BD_BUILD})" \
    && go version -m /out/bd | tr '\t' ' ' | grep -Fq "dep google.golang.org/grpc v${GRPC_VERSION} "

FROM ${BASE_IMAGE}

ARG OMNIGENT_VERSION=0.10.0.dev0
ARG OMNIGENT_SOURCE_REF=2aba5079d4d3a2a84d8c9927884fc4b8ce0eeecc

LABEL io.gascity.omnigent.version="${OMNIGENT_VERSION}" \
	io.gascity.omnigent.source-ref="${OMNIGENT_SOURCE_REF}"

ENV PATH="/opt/omnigent/bin:${PATH}" \
	OMNIGENT_NO_UPDATE_CHECK=1 \
	OMNIGENT_DISABLE_TELEMETRY=true \
	OMNIGENT_TELEMETRY_ENABLED=0 \
	OMNIGENT_OTEL_CAPTURE_CONTENT=0 \
	OMNIGENT_DISABLE_KEYRING=1 \
	DO_NOT_TRACK=1

# Build-time copies and ownership fixes require root; the final image drops
# back to gcagent below.
USER root

# Omnigent owns only the capsule-local harness lifecycle. Gas City owns remote
# placement; no hosted auth, managed-host, Daytona, or Kubernetes extra is
# installed. Runtime credentials and conversation state are mounted later.
COPY --from=omnigent-builder /opt/omnigent /opt/omnigent
COPY --from=omnigent-builder /out/omnigent-provenance.env /usr/share/gascity/omnigent-provenance.env
RUN ln -s /opt/omnigent/bin/omnigent /usr/local/bin/omnigent \
	&& ln -s /opt/omnigent/bin/omni /usr/local/bin/omni \
	&& HOME=/tmp/omnigent-build-home \
		OMNIGENT_CONFIG_HOME=/tmp/omnigent-build-config \
		OMNIGENT_DATA_DIR=/tmp/omnigent-build-data \
		omnigent --version \
	&& rm -rf /tmp/omnigent-build-home /tmp/omnigent-build-config /tmp/omnigent-build-data

# bd (beads) CLI, rebuilt above from checksum-pinned release source.
COPY --from=bd-builder /out/bd /usr/local/bin/bd
RUN BD_DISABLE_METRICS=1 BD_DISABLE_EVENT_FLUSH=1 bd --version

# br (beads_rust) CLI — copied from build context.
# Build with: cp $(which br) . && docker build ...
COPY br /usr/local/bin/br

# gc binary — copied from build context.
COPY gc /usr/local/bin/gc
RUN gc version

# gc-beads-br script for the exec:beads protocol.
COPY contrib/beads-scripts/gc-beads-br /usr/local/bin/gc-beads-br

# gc-mail-mcp-agent-mail script for the exec:mail protocol.
COPY contrib/mail-scripts/gc-mail-mcp-agent-mail /usr/local/bin/gc-mail-mcp-agent-mail

# Claude credentials are injected at runtime via K8s Secret volume mount,
# not baked into the image. See contrib/k8s/README-credentials.md.
# The CLAUDE_CONFIG_DIR env var (set by gc-session-k8s) points to the mount.

WORKDIR /workspace
RUN chown gcagent:gcagent /workspace

# Default user. When LINUX_USERNAME is set, the pod spec overrides to root
# (UID 0) via securityContext so the entrypoint can create the dynamic user
# before dropping privileges.
USER gcagent

CMD ["/bin/bash"]
